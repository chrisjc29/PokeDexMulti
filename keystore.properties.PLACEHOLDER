# Copy to keystore.properties (git-ignored) and fill in, or set the matching env vars in CI:
#   storeFile     / ANDROID_KEYSTORE_FILE      path to the .jks keystore
#   storePassword / ANDROID_KEYSTORE_PASSWORD
#   keyAlias      / ANDROID_KEY_ALIAS
#   keyPassword   / ANDROID_KEY_PASSWORD
# If neither the file nor the env vars are present, release builds are left unsigned and every other
# task — debug builds, tests, CI checks — keeps working without secrets.
storeFile=
storePassword=
keyAlias=
keyPassword=
