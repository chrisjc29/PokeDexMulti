# --- Gradle / Kotlin ---
.gradle/
build/
**/build/
# don't ignore a source package literally named "build"
!src/**/build/
# Kotlin 2.x build services / KMP metadata cache
.kotlin/
*.iml
*.hprof
# machine-specific SDK paths — never commit
local.properties

# --- IDE (Android Studio / IntelliJ / Fleet / VS Code / Xcode) ---
.idea/
!.idea/copyright/
.fleet/
.vscode/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
**/xcuserdata/

# --- Android ---
*.apk
*.aab
*.ap_
*.dex
captures/
.cxx/
# signing secrets; the .PLACEHOLDER IS committed
keystore.properties

# --- iOS / Xcode / CocoaPods (if used) ---
Pods/
*.xcworkspace/xcuserdata/
DerivedData/

# --- Roborazzi: goldens live in src/androidUnitTest/screenshots/ and ARE committed.
#     Only the throwaway comparison/diff artifacts under build/ are ignored. ---
**/build/outputs/roborazzi/

# --- Firebase config: keep real keys out of git (only relevant when firebase.enabled=true) ---
composeApp/google-services.json
iosApp/iosApp/GoogleService-Info.plist
# The *.PLACEHOLDER files ARE committed — they document what to drop in.

# --- Firebase CLI / emulator logs ---
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# --- Local agent/editor tooling: not part of the app ---
.claude/

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Fastlane: report.xml and the plugin gem cache are regenerated on every lane run ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
vendor/bundle/
.bundle/
